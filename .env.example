# ── MinIO 連線設定 ──────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

MINIO_SECURE=false

# ── Kafka 設定 ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka0:29092

# ── bucket 市場 ─────────────────────────────────────────────
MINIO_BUCKET=

# ── Slack 通知設定 ──────────────────────────────────────────
SLACK_RT_PIPE_WEBHOOK_URL=

# ── Finnhub API 設定 ───────────────────────────────────────
FINNHUB_API_KEYS='[
  "example1",
  "example2",
  "example3"
]'
